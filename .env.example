# Server-only local SQLite file; relative paths resolve from the repository root.
DATABASE_PATH=./data/3t.sqlite

# Use your exact public HTTPS origin in production; keep it stable for passkeys.
APP_ORIGIN=http://localhost:3000
# Optional; when set it must match the APP_ORIGIN hostname.
# WEBAUTHN_RP_ID=localhost

# Generate two independent 32-byte random values; see docs/SECURITY.md.
# Replace these empty placeholders before running the application.
CREDENTIAL_ROOT_KEY=
OWNER_SETUP_TOKEN=
